# Copy to .env.local (gitignored). Do NOT commit secrets.

# ---- Postgres (Neon) ----
# Grab from Neon console -> Connection Details -> "Prisma" style URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Same Neon database, DIRECT (non-pooled) endpoint: the identical URL with
# "-pooler" removed from the host. Used ONLY by `prisma migrate` commands,
# which cannot run through the pooler. The app never reads this.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- NextAuth ----
# `openssl rand -base64 32` to generate a secret.
NEXTAUTH_SECRET=""
# In dev this should be http://localhost:3000. In prod, the deployed URL.
NEXTAUTH_URL="http://localhost:3000"

# ---- Public BreakPoint Talent jobs feed ----
# Only this Ace user's My Jobs + Active rows are exposed publicly.
PUBLIC_JOBS_OWNER_EMAIL="andrew@breakpointtalent.com"
# Netlify creates this URL under Build & deploy -> Build hooks. Ace posts
# to it after public-facing job changes so breakpointtalent.com rebuilds.
NETLIFY_JOBS_BUILD_HOOK=""

# ---- Google OAuth (Workspace: breakpointtalent.com) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- RecruiterFlow ----
# Retired in Phase 5 — the RF runtime API surface was deleted from the
# app. Remove RECRUITERFLOW_API_KEY + RECRUITERFLOW_BASE_URL from your
# local .env.local and from GitHub Actions secrets
# (github.com/andrewmkraig-cyber/BreakPoint-crm/settings/secrets/actions).

# ---- Krispcall (Day 4) ----
KRISPCALL_CLIENT_ID="763ba0730e00c06a5ed3"
KRISPCALL_CLIENT_SECRET="3088540405f381475a41304e424685aa35ca166e"

# ---- Instantly (read-only) ----
# API v2 key from Instantly -> Settings -> Integrations -> API Keys.
# Needs a READ scope only (all:read, or the per-resource *:read scopes -
# campaigns:read, emails:read, workspaces:read). Ace never sends,
# replies, creates, pauses, or modifies anything in Instantly, so a
# write-capable key grants more than this integration will ever use.
# Server-side only - never exposed to the browser.
INSTANTLY_API_KEY=""

# ---- Sentry performance trace sampling ----
# Control Sentry performance trace sampling (0-1). Leave unset to use the low
# in-code defaults (server/edge 0.05, client 0.02); raise temporarily to debug.
SENTRY_TRACES_SAMPLE_RATE="0.05"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.02"
