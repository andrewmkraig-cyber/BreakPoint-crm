  mercuryApiKey String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User                     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  memberships OrganizationMembership[]

  candidates               Candidate[]
  jobs                     Job[]
  clients                  Client[]
  contacts                 Contact[]
  placements               Placement[]
  interviews               Interview[]
  invoices                 Invoice[]
  clientAgreements         ClientAgreement[]
  clientBenefits           ClientBenefits[]
  clientBenefitsFiles      ClientBenefitsFile[]
  candidateResumes         CandidateResume[]
  jobOverrides             JobOverride[]
  actionLogs               ActionLog[]
  activityLogs             ActivityLog[]
  // Phase 5A.4: per-org candidate lists. Cascade-delete on the list
  // side so deleting an org tears down its lists too.
  candidateLists           CandidateList[]
  gmailTags                GmailThreadTag[]
  candidateMatches         CandidateMatch[]
  personalTrainerRules     PersonalTrainerRule[]
  claudePanelMessages      ClaudePanelMessage[]
  instantlyReplies         InstantlyReply[]
  jobBoardStatuses         JobBoardStatus[]
  wordsOfDay               WordOfDay[]
  quotesOfDay              QuoteOfDay[]
  dailyNewsFeeds           DailyNewsFeed[]
  chessPuzzlesOfDay        ChessPuzzleOfDay[]
  chessPuzzleStreaks       ChessPuzzleStreak[]
  funFacts                 FunFact[]
  verticals                Vertical[]
  savedSearches            SavedSearch[]
  savedSearchVersions      SavedSearchVersion[]
  sendingDomains           SendingDomain[]
  bdRuns                   BDRun[]
  campaigns                Campaign[]
  campaignEvents           CampaignEvent[]
  bdActivities             BDActivity[]
  clientSignals            ClientSignal[]
  bdOrgConfig              BdOrgConfig?
  bdContactTargeting       BdContactTargeting[]
  bdSequences              BdSequence[]
  bdReplyPromptDismissals  BdReplyPromptDismissal[]
  calendarEvents           CalendarEvent[]
  aceReminders             AceReminder[]
  toolExpenses             ToolExpense[]
  pushSubscriptions        PushSubscription[]
  gmailPushWatches         GmailPushWatch[]
  microsoftToken           MicrosoftToken?
  triggerRules             TriggerRule[]
  notes                    Note[]
  scheduledEmails          ScheduledEmail[]
  invoiceEmailDrafts       InvoiceEmailDraft[]
  fitnessExercises         Exercise[]
  workoutDays              WorkoutDay[]
  workouts                 Workout[]
  workoutSets              WorkoutSet[]
  dailySteps               DailySteps[]
  fitnessHealthConnections FitnessHealthConnection[]
  goals                    Goal[]
  goalActualEntries        GoalActualEntry[]
}

// One row per org holding the Microsoft Graph OAuth tokens that let us
// mint Teams meeting links when scheduling interviews. Org-scoped (not
// per-user) because BreakPoint runs one Microsoft tenant per
// Organization; the email column records which Microsoft account was
// connected so the Settings panel can show it back.
model MicrosoftToken {
  id             String       @id @default(cuid())
  organizationId String       @unique
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  email          String?
  // "connected" while the token (or its refresh grant) is usable;
  // "expired" once a refresh fails (invalid_grant / missing refresh
  // token). Drives the amber reconnect banner in Settings > Connectors.
  status         String       @default("connected")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// One row per Gmail mailbox we've registered a Pub/Sub watch on.
// Gmail watches expire after 7 days max — the renew cron refreshes
// any row whose expiresAt is within 24h. lastHistoryId is the
// pointer we pass to users.history.list on the next push to fetch
// only the new messages since the previous notification.
model GmailPushWatch {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  expiresAt      DateTime
  lastHistoryId  String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
}

// Tracks the recurring + one-time tool/software costs the desk pays.
// Powers the Total Expenses YTD + Gross Margin tiles on the Financial
// Performance dashboard tab. `cost * paidCount` is the running total
// paid to date for the line item.
model ToolExpense {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  cost           Float
  frequency      String
  paidCount      Int          @default(1)
  startDate      DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Invoice {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id])
  invoiceNumber    String
  placementId      String?
  placement        Placement?            @relation(fields: [placementId], references: [id])
  candidateId      String?
  candidate        Candidate?            @relation(fields: [candidateId], references: [id])
  clientId         String?
  client           Client?               @relation(fields: [clientId], references: [id])
  roleTitle        String?
  startDate        DateTime?
  feeAmount        Decimal?              @db.Decimal(10, 2)
  // Snapshot columns copied from the placement at create time so the
  // invoice stays self-describing even if the source placement is
  // later edited or deleted. Test invoices (no linked placement) write
  // these directly. Reads in the PDF + detail UI now hit these columns
  // instead of joining through Placement.
  baseSalary       Decimal?              @db.Decimal(10, 2)
  feePercentage    Decimal?              @db.Decimal(5, 2)
  paymentTerms     String?               @default("Net 30")
  dueDate          DateTime?
  billingContacts  Json                  @default("[]")
  hiringContacts   Json                  @default("[]")
  status           InvoiceStatus         @default(DRAFT)
  pdfPath          String?
  sentAt           DateTime?
  paidAt           DateTime?
  // Selected before the recruiter flips an invoice to PAID. Surfaces on
  // both the invoice detail view and the linked Placement so the desk
  // can scan how clients are actually paying without opening each PDF.
  paymentMethod    InvoicePaymentMethod?
  // Internal-only memo. NEVER prints on the client PDF — surfaced only in
  // the invoice detail editor for the recruiter's own reference.
  notes            String?
  // Client-facing note. Prints on the invoice PDF (the "Note:" block).
  // Separate from `notes` so internal bookkeeping (e.g. installment
  // tracking) never leaks onto the document the client receives.
  clientNote       String?
  // Verified Gmail "Send mail as" alias the invoice email should go out
  // from. Set by the From selector on the invoice detail page. Null =
  // fall back to the billing AR email if it's a verified alias, otherwise
  // the Gmail account's primary address.
  sendFromAlias    String?
  // True when this draft is a pre-staged "future" installment that
  // should NOT appear in the main Invoices list. Set on installment 2/3
  // drafts created at Confirm Start for placements with custom payment
  // terms; the Future Invoices section on /finances surfaces these.
  // Cleared automatically when the invoice is marked SENT or PAID so it
  // joins the normal lists from that point on.
  isFuture         Boolean               @default(false)
  // Set when this invoice bills a retained engagement rather than a
  // placement. A retained invoice has retainedSearchId set and BOTH
  // placementId and candidateId null — which is why any revenue path
  // that reaches an Invoice by joining through Placement silently drops
  // it. Scalar FK, no Prisma relation — see the RetainedSearch model
  // comment.
  retainedSearchId String?
  emailDrafts      InvoiceEmailDraft[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, isFuture])
  @@index([retainedSearchId])
}

// Editable Gmail draft payloads launched from an Invoice detail page.
// Gmail remains the visible Drafts folder, but this row is the Ace-side
// source the invoice page reopens so edits made in /mail Drafts survive
// when the recruiter comes back through /invoices.
model InvoiceEmailDraft {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  invoiceId      String
  to             String[] @default([])
  cc             String[] @default([])
  bcc            String[] @default([])
  subject        String
  bodyHtml       String   @db.Text
  bodyText       String   @db.Text
  threadId       String?
  sendAsEmail    String?
  attachments    Json?
  gmailDraftId   String?
  gmailThreadId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([gmailDraftId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum InvoicePaymentMethod {
  CHECK
  ACH
  CREDIT
}

// A retained search engagement — the client pays to run the search, not
// (only) to fill it. The money is committed up front against the Client
// and Job, so a RetainedSearch exists BEFORE any Placement and may never
// produce one at all (CLOSED_UNFILLED). That is the whole reason it is a
// first-class model: nearly every revenue surface in the app roots its
// query at Placement, and a retained engagement has no Placement and no
// Candidate to root through.
//
// Money type: totalAmount is Int (whole US dollars) to match
// Placement.feeTotal, the placement-side money column this number stands
// in for. Invoice.feeAmount is Decimal(10,2) — the two money types
// already differ in this schema and this model deliberately does not
// introduce a third.
//
// FKs here are scalar-only (no Prisma relation fields) so the model can
// land without editing the relation blocks on Client / Job /
// Organization / Placement, and so the two-way RetainedSearch <-> Placement
// link doesn't need disambiguating relation names.
model RetainedSearch {
  id              String               @id @default(cuid())
  organizationId  String
  // Both required — a retained search is always sold against a specific
  // client and a specific role.
  clientId        String
  jobId           String
  // Whole US dollars, matching Placement.feeTotal.
  totalAmount     Int
  // Free-text terms string in the same shape Invoice.paymentTerms uses
  // ("Net 30" / "Net 10" / "Due on receipt"), produced by
  // paymentTermsLabel() in src/lib/payment-terms.ts. Same default as
  // Invoice.paymentTerms.
  paymentTerms    String               @default("Net 30")
  guaranteeDays   Int
  // True when the engagement bills in installments (engaged / midpoint /
  // completion) rather than one up-front invoice.
  useInstallments Boolean              @default(false)
  status          RetainedSearchStatus @default(OPEN)
  // The eventual fill. Null until a candidate starts; a retained search
  // that closes unfilled never gets one.
  placementId     String?
  closedAt        DateTime?
  closeReason     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([organizationId, status])
}

// One scheduled payment on a retained search that bills in stages
// (engaged / midpoint / completion). Rows exist only when the parent
// RetainedSearch has useInstallments = true, and they are written inside
// the same transaction as the parent so a partial save is impossible.
//
// amount is Int (whole US dollars) to match RetainedSearch.totalAmount,
// and createRetainedSearch enforces that the rows sum EXACTLY to that
// total before either side is written.
//
// invoiceId is stamped when this installment's DRAFT invoice is
// generated. Installment 1 gets a live draft immediately; later
// installments get pre-staged isFuture drafts plus a reminder, mirroring
// the placement-side custom-terms flow in confirmStart.
//
// Scalar-only FKs, matching the RetainedSearch model above.
model RetainedSearchInstallment {
  id               String   @id @default(cuid())
  organizationId   String
  retainedSearchId String
  // 1-based display order. Installment 1 is the one billed on save.
  sequence         Int
  // Whole US dollars, matching RetainedSearch.totalAmount.
  amount           Int
  dueDate          DateTime
  // Set once this installment's invoice exists. Null until then.
  invoiceId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId])
  @@index([retainedSearchId])
  @@index([organizationId, retainedSearchId])
}

enum RetainedSearchStatus {
  OPEN
  FILLED
  CLOSED_UNFILLED
}

// Mirrors a Google Calendar event for read-only display inside Ace.
// The sync job upserts these rows on demand keyed by
// (organizationId, googleEventId, calendarId) — calendarId varies per
// shared calendar (Andrew's primary + Austin's + any team calendars)
// so the same Google eventId can appear once per calendar without
// colliding. Status, attendees, and location are mirrored verbatim;
// candidateId/jobId/clientId stay null until a future pass correlates
// events to internal records.
model CalendarEvent {
  id             String              @id @default(cuid())
  organizationId String
  googleEventId  String
  calendarId     String
  calendarName   String              @default("primary")
  calendarColor  String?
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  allDay         Boolean             @default(false)
  location       String?
  attendees      Json?
  status         CalendarEventStatus @default(CONFIRMED)
  // Conference link surfaced from Google: hangoutLink first, then the
  // first video entryPoint in conferenceData. Stored separately from
  // location so a Zoom URL in the location field never overwrites it
  // and vice versa. Null when the Google event has no video link.
  meetLink       String?
  // Google's own canonical URL for the event (htmlLink). Used by the
  // drawer's "Open in Google Calendar" bridge so the recruiter can
  // reschedule/edit in Google while Ace-native editing is still being
  // wired up.
  htmlLink       String?
  candidateId    String?
  jobId          String?
  clientId       String?
  // Recruiter-chosen event type override from the drawer pill picker.
  // Null means "let the page derive a type heuristically from title +
  // calendar name"; a non-null value overrides the heuristic and is
  // canonical. One of: "interview" | "client" | "reminder" | "other".
  typeOverride   String?
  syncedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  candidate    Candidate?   @relation(fields: [candidateId], references: [id])
  job          Job?         @relation(fields: [jobId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  @@unique([organizationId, googleEventId, calendarId])
  @@index([organizationId, startTime])
}

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model ClaudePanelMessage {
  id             String       @id @default(cuid())
  organizationId String
  role           String
  content        String       @db.Text
  // Groups messages into a single Claude Panel "conversation". Clear
  // Chat rotates the active conversationId on the client rather than
  // deleting Neon rows, so cleared sessions are preserved as their own
  // entry on the Settings → Claude History tab. Nullable for the rows
  // that predate this column; History bucketed those by createdAt date.
  conversationId String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, conversationId])
}

// Personal Trainer rules — Andrew-curated standing instructions injected
// into every Claude-system-prompt across Ace. Source of truth lives here
// (Neon); a copy is mirrored to docs/ace/PERSONAL_TRAINER.md on every
// add/update/delete via the GitHub API for visibility, but writes always
// hit Neon first. Org-scoped so a future tenant can have its own rule
// set without affecting BreakPoint Talent's.
model PersonalTrainerRule {
  id             String   @id @default(cuid())
  organizationId String
  text           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Ace Fitness: workout sessions are org-scoped for tenant cleanup and
// user-owned so Andrew and Austin can track private sessions without
// commingling live workout data.
model WorkoutDay {
  id              String    @id @default(cuid())
  organizationId  String
  userId          String
  date            DateTime  @db.Date
  dayType         String
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts     Workout[]

  @@index([organizationId, userId, date])
  @@index([organizationId, userId, startedAt])
  @@index([organizationId, date])
  @@index([userId, date])
}

// Shared default exercises live at ownerKey="default"; custom exercises
// carry ownerKey=userId and userId=<creator>. Routes only expose defaults
// plus the signed-in user's custom rows, which keeps customs private.
model Exercise {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  ownerKey       String   @default("default")
  name           String
  slug           String
  bodyPart       String
  defaultDay     String?
  sortOrder      Int      @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts     Workout[]

  @@unique([organizationId, ownerKey, slug])
  @@index([organizationId, isDefault, sortOrder])
  @@index([organizationId, userId])
  @@index([organizationId, bodyPart])
}

model Workout {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workoutDayId   String
  exerciseId     String
  exerciseName   String?
  performedAt    DateTime @default(now())
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDay   WorkoutDay   @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets         WorkoutSet[]

  @@index([organizationId, userId, performedAt])
  @@index([workoutDayId])
  @@index([exerciseId, performedAt])
}

model WorkoutSet {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workoutId      String
  setNumber      Int
  weightLbs      Float?
  reps           Int?
  rpe            Float?
  isPr           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout      Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, setNumber])
  @@index([organizationId, userId])
}

model DailySteps {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  date           DateTime @db.Date
  steps          Int      @default(0)
  source         String   @default("manual")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, date])
  @@index([organizationId, date])
  @@index([userId, date])
}

model FitnessHealthConnection {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  source         String    @default("apple-health-shortcut")
  tokenHash      String    @unique
  enabled        Boolean   @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, source])
  @@index([organizationId, userId])
}

// Phase 5A.4: per-org candidate lists. Recruiter-curated buckets of
// candidates ("Top Tax Candidates", "Q4 follow-ups", etc.) used to
// filter the /candidates page and pivot candidate views. The list
// itself is org-scoped; memberships inherit org scoping through the
// list.list.organizationId path. (organizationId, name) is unique so
// two orgs can have a list with the same name without collision.
model CandidateList {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                      @relation("CandidateListCreatedBy", fields: [createdById], references: [id])
  memberships  CandidateListMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Join row between CandidateList and Candidate. Cascade-deletes from
// either side: removing a list drops every membership row (but leaves
// the candidates intact); removing a candidate drops its list
// memberships (but leaves the lists intact). (listId, candidateId)
// is unique so the same candidate can't be added to the same list
// twice.
model CandidateListMembership {
  id          String   @id @default(cuid())
  listId      String
  candidateId String
  addedAt     DateTime @default(now())

  list      CandidateList @relation(fields: [listId], references: [id], onDelete: Cascade)
  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([listId, candidateId])
  @@index([listId])
  @@index([candidateId])
}

// Phase 4c: ActivityLog is the canonical, tenant-scoped audit feed for
// user-initiated events across Ace. Separate from ActionLog (which is
// an older, hand-curated log used by specific workflows) — ActivityLog
// is general-purpose: every important user action lands here with a
// standard shape so Dashboard rollups, per-entity activity panels, and
// future admin audit tooling all read from one table.
//
// Action types fired today (Phase 4c):
//   candidate_created, submittal_sent, placement_confirmed
// Future (Phase 4d or wire-as-touched):
//   candidate_applied_to_job, interview_scheduled,
//   interview_cancelled, offer_extended, email_sent
// Intentionally excluded:
//   call_logged — Quo (OpenPhone-rebranded) webhook writes to CallLog.
//   Deferred until the audit-feed surfaces call rows on the activity
//   panel — at that point wire logActivity into the same webhook code
//   path that writes CallLog.
//
// targetType / targetId are a polymorphic FK to whatever the action is
// about (candidate / job / client / placement / interview). No referential
// integrity at the DB level so retention can tombstone target rows
// without cascading here.
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  timestamp      DateTime @default(now())
  actionType     String
  targetType     String
  targetId       String
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite index powers the Dashboard + per-user activity feeds
  // without a sort-after-filter step. (orgId, timestamp DESC) is the
  // typical read pattern: newest-first inside one tenant.
  @@index([organizationId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actionType])
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model GmailThreadTag {
  id             String   @id @default(cuid())
  threadId       String
  candidateId    String?
  clientId       String?
  organizationId String
  createdAt      DateTime @default(now())

  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([threadId, candidateId])
  @@unique([threadId, clientId])
  @@index([candidateId])
  @@index([clientId])
  @@index([organizationId])
}

// One row per org per day. The /api/word-of-day route checks for an
// existing row keyed on (organizationId, generatedDate) before calling
// Claude — so subsequent loads on the same ET day reuse the cached
// payload instead of spinning the model. generatedDate is @db.Date so
// the unique constraint compares calendar days, not instants.
model WordOfDay {
  id              String   @id @default(cuid())
  organizationId  String
  word            String
  partOfSpeech    String
  definition      String   @db.Text
  exampleSentence String   @db.Text
  generatedDate   DateTime @db.Date
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// Companion to WordOfDay — one row per (org, ET day) carrying a curated
// quote from a respected business leader, athlete, philosopher, or
// historical figure. /api/quote-of-day reuses the same cache-then-call
// pattern: today's row is returned without touching Claude on every
// load except the first of the ET day.
model QuoteOfDay {
  id             String   @id @default(cuid())
  organizationId String
  quote          String   @db.Text
  author         String
  context        String   @db.Text
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// One Lichess puzzle per (org, ET day). /api/chess-puzzle hits Lichess
// once on the first request of the day for an org and persists the
// result so every recruiter in the org sees the same board. Streak
// state stays in localStorage per browser — solving for the org would
// be weird (one person clicks a piece, the other gets credit).
// solution and themes are JSON to avoid a separate ordering column on
// the move list.
model ChessPuzzleOfDay {
  id             String   @id @default(cuid())
  organizationId String
  lichessId      String
  rating         Int
  fen            String   @db.Text
  solution       Json
  themes         Json
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// Per-user chess-puzzle streak. Lives on User (not Organization) so the
// daily count follows the recruiter across devices — solving today's
// puzzle on the iPad must credit the same row the laptop wrote. ET date
// strings (YYYY-MM-DD) match the client's todayET() formatter so a
// straight string compare drives the "solved today" / "failed today"
// guards. organizationId is denormalized for cleanup queries; it is not
// part of the unique key.
model ChessPuzzleStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  streak         Int      @default(0)
  lastSolvedDate String?
  failedDate     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// One Claude-generated fun fact per (org, ET day). The route rotates
// through topic categories (history, technology, science, geography,
// trivia) with weights biased by each user's recent thumbs feedback —
// so liked topics surface more often, disliked topics fade. Year is
// optional because non-history topics often don't have one.
model FunFact {
  id             String   @id @default(cuid())
  organizationId String
  topic          String
  year           Int?
  text           String   @db.Text
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feedback     FunFactFeedback[]

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// Per-user thumbs up/down feedback on a FunFact. The next day's
// generator reads this to bias topic selection toward the user's
// likes. One vote per (factId, userId); re-voting overwrites.
model FunFactFeedback {
  id        String   @id @default(cuid())
  factId    String
  userId    String
  vote      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fact FunFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([factId, userId])
  @@index([userId])
  @@index([factId])
}

// One row per (org, tab, ET day). The /api/news-feed route checks for
// today's row for the requested tab before invoking Claude — so once a
// recruiter clicks a tab, the headlines stay sticky for the rest of
// the ET day. headlines is a Json column carrying the {headline,
// source, url, summary}[] payload Claude returns; we don't normalize
// it because it's read-only inside the dashboard widget.
model DailyNewsFeed {
  id             String   @id @default(cuid())
  organizationId String
  tab            String
  headlines      Json
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tab, generatedDate])
  @@index([organizationId])
}

// ---- BD (Business Development) ----
// Outbound sequence orchestration. Ace = control center, Apollo =
// execution, Indeed = discovery. The morning cron picks up BDRuns with
// status=QUEUED and walks them through Indeed → Apollo. All BD models
// are tenant-scoped via organizationId per architecture rule 8.

enum BDRunStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  ENROLLING
  COMPLETE
  FAILED
  DISMISSED
}

enum SendingDomainStatus {
  HEALTHY
  WARMING
  COOLED
}

enum BDActivityKind {
  SCAN_COMPLETE
  ENRICH
  ENROLL
  OPEN
  REPLY
  BOUNCE
  UNSUB
  DOMAIN_COOLED
  DOMAIN_RESUMED
}

enum ClientSignalStatus {
  NEW
  ACTED
  DISMISSED
}

// Highest-level BD grouping. Drives the segmented control on Today's
// Launch and scopes saved searches + campaigns. Slug is the URL-safe
// identifier (e.g. "tax", "audit", "fpa"); name is the display label.
model Vertical {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  active         Boolean  @default(true)
  // Optional per-vertical override on the BD daily contact cap. Null
  // means inherit from BdOrgConfig.globalDailyCap.
  dailyCap       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedSearches    SavedSearch[]
  bdRuns           BDRun[]
  campaigns        Campaign[]
  clientSignals    ClientSignal[]
  contactTargeting BdContactTargeting?
  bdSequences      BdSequence[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// A recruiter-defined BD search — the criteria the morning Indeed scan
// uses to discover target companies. `criteria` Json is opaque to Ace
// (Indeed query shape lives there). `contactCap` overrides the org-level
// daily contact cap when set; null inherits.
model SavedSearch {
  id                      String    @id @default(cuid())
  organizationId          String
  verticalId              String
  name                    String
  criteria                Json
  // Optional TheirStack saved-search id (one-to-one). When set, discovery
  // fetches that saved search's stored filters (GET /v0/saved_searches/{id})
  // and replays them via POST /v1/jobs/search, instead of the hardcoded
  // DISCOVERY_TITLES. Blank = run the default nationwide title search.
  theirstackSavedSearchId String?
  active                  Boolean   @default(true)
  // Per-search schedule for the 6 AM discovery cron. runFrequencyDays:
  // 1 = daily, 7 = weekly, 15 = every 15 days, etc. lastDiscoveredAt is
  // stamped each time the cron actually runs this search; the cron only
  // runs a search when it is active AND (lastDiscoveredAt is null OR
  // enough ET days have passed). "Run Discovery Now" ignores the schedule
  // but still respects active=false. Defaults keep today's behavior
  // (every active search runs daily).
  runFrequencyDays        Int       @default(1)
  lastDiscoveredAt        DateTime?
  contactCap              Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical             @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  versions     SavedSearchVersion[]
  bdRuns       BDRun[]
  campaigns    Campaign[]

  @@index([organizationId])
  @@index([verticalId])
}

// Append-only history of SavedSearch.criteria. One row per edit so
// later we can answer "what criteria did the 2026-03-04 run use?".
model SavedSearchVersion {
  id             String   @id @default(cuid())
  organizationId String
  savedSearchId  String
  criteria       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch  @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([savedSearchId, createdAt])
}

// One of the warmed sending domains Apollo rotates outbound across.
// Status WARMING / COOLED short-circuits the rotation; lastUsedAt
// drives round-robin selection at enroll time. apolloMailboxId pins
// the rotation slot to a specific Apollo sender.
model SendingDomain {
  id              String              @id @default(cuid())
  organizationId  String
  domain          String
  status          SendingDomainStatus @default(HEALTHY)
  apolloMailboxId String?
  dailyCap        Int?
  // Recruiter who owns the inbox tied to this warmed domain. Free-form
  // string so the UI can let either Andrew/Austin (or anyone added
  // later) own a slot without enum churn.
  inboxOwner      String?
  lastUsedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId])
}

// One row per Launch BD Run. Created on Launch click (status=QUEUED).
// The morning cron flips QUEUED → RUNNING, then COMPLETE / FAILED with
// metrics JSON capturing the actual scan/enrich/enroll counts so the
// Active Campaigns + Activity tabs can render the daily breakdown
// without re-hitting Indeed/Apollo on every load.
model BDRun {
  id                    String      @id @default(cuid())
  organizationId        String
  // verticalId/savedSearchId are nullable so the org-wide BD discovery
  // cron can write a run that isn't tied to a single Launch saved-search.
  // Launch-initiated runs still pass both; only the cron leaves them null.
  verticalId            String?
  savedSearchId         String?
  status                BDRunStatus @default(QUEUED)
  discoveryProvider     String      @default("theirstack")
  discoveredCount       Int         @default(0)
  // Post-filter discovered jobs array written by the BD discovery cron.
  // Approval flow reads this; once approved, the BDRun moves on to enroll.
  discoveredPayload     Json?
  approvedAt            DateTime?
  enrolledCount         Int         @default(0)
  // Manual "Run Discovery Now" override: max contacts to enroll per
  // company at approve time. Null on the scheduled morning cron and on
  // legacy runs, both of which fall back to the hardcoded default of 4
  // in enrollCompaniesInApollo. Companies count is not stored — it's
  // consumed inline during the discovery request, not at enroll time.
  maxContactsPerCompany Int?
  // Launch-time snapshot the cron reads when it picks the run up:
  // contact cap, sequence id, rotation pool, etc. Shape will drift
  // as we wire Apollo, so it stays as Json instead of a column wave.
  plan                  Json?
  // Cron writes the final breakdown here on completion:
  // { companies, contacts, enrolled, errors }. Null until complete.
  metrics               Json?
  startedAt             DateTime?
  completedAt           DateTime?
  errorMessage          String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical?    @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  activities   BDActivity[]

  @@index([organizationId, createdAt])
  @@index([status])
  @@index([verticalId])
  @@index([savedSearchId])
}

// An active outbound campaign in Apollo, tracked from the Ace side.
// apolloSequenceId is the Apollo sequence id contacts get enrolled into
// — Ace never edits Apollo's copy, only records the linkage. Counters
// are denormalized for the Active Campaigns table; CampaignEvent has
// the granular per-contact log if a recompute is ever needed.
model Campaign {
  id               String    @id @default(cuid())
  organizationId   String
  verticalId       String
  savedSearchId    String
  bdRunId          String?
  apolloSequenceId String
  name             String
  enrolled         Int       @default(0)
  opens            Int       @default(0)
  replies          Int       @default(0)
  bounces          Int       @default(0)
  unsubs           Int       @default(0)
  active           Boolean   @default(true)
  startedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical        @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch     @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  bdRun        BDRun?          @relation(fields: [bdRunId], references: [id], onDelete: SetNull)
  events       CampaignEvent[]

  @@index([organizationId])
  @@index([verticalId])
  @@index([active])
}

// Granular per-contact event log within a campaign. Apollo webhook
// writes one row per open/reply/bounce/unsub. Powers the Activity tab
// feed and lets us recompute Campaign counters if drift is suspected.
// apolloContactId is free-form because Apollo is the source of truth
// for outbound contacts — Ace doesn't ingest them into Contact.
model CampaignEvent {
  id              String         @id @default(cuid())
  organizationId  String
  campaignId      String
  kind            BDActivityKind
  apolloContactId String?
  metadata        Json?
  occurredAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([kind])
}

// BD-specific audit feed for the Activity tab. Mirrors ActivityLog's
// pattern but kept on a separate table so BD events don't dilute the
// general activity surface. Polymorphic target via targetType/targetId
// (e.g. "company", "campaign", "domain") with no DB-level FK so
// retention can tombstone targets without cascade.
model BDActivity {
  id             String         @id @default(cuid())
  organizationId String
  bdRunId        String?
  kind           BDActivityKind
  targetType     String?
  targetId       String?
  metadata       Json?
  occurredAt     DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bdRun        BDRun?       @relation(fields: [bdRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([bdRunId])
  @@index([kind])
}

// Org-level BD configuration: global daily contact cap, pause-all
// kill switch, blackout windows, and Reply Routing toggles. One row
// per organization, keyed on organizationId so reads are a single
// findUnique. UI in /settings/bd writes here; /bd/launch reads
// pauseAll + globalDailyCap on every render to gate the Launch CTA.
model BdOrgConfig {
  organizationId String @id

  // Master gate for the BD engine. The daily discovery cron and the
  // TheirStack webhook both no-op when false. Distinct from pauseAll,
  // which gates the Launch CTA only.
  engineActive   Boolean @default(false)
  globalDailyCap Int     @default(80)
  pauseAll       Boolean @default(false)

  // Rotating cursor for the daily client-signal sweep (client-signal-sync.ts).
  // The sweep runs under a 20s wall-clock budget, so on a large client book a
  // single run can't scan everyone. We store the id of the last client examined
  // and resume after it next run, wrapping around, so every client is eventually
  // covered. Reset to null when a sweep completes a full uninterrupted loop.
  lastSignalCursorId String?

  // Calendar-day (America/New_York) guard for the client-signal sweep. The
  // sweep runs once per morning cron; this records the ET day it last ran so a
  // duplicate cron fire (or any re-trigger) the same day no-ops instead of
  // re-spending TheirStack credits. Manual "Run Discovery Now" never runs the
  // sweep at all. Null until the first sweep.
  lastClientMonitorAt DateTime?

  blackoutWeekends   Boolean @default(false)
  blackoutHolidays   Boolean @default(false)
  blackoutBefore7am  Boolean @default(false)
  blackoutAfter530pm Boolean @default(false)

  replyForwardApollo       Boolean @default(false)
  replyAutoCreateCandidate Boolean @default(true)
  replyOooFilter           Boolean @default(true)
  // When true the mail thread view shows a one-shot prompt offering to
  // create a Client (with prefilled name/domain/contacts) from a BD reply.
  // Per-thread dismissal lives in BdReplyPromptDismissal.
  replyPromptCreateClient  Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Per-vertical Apollo contact targeting rules. apollo-contacts reads
// this at runtime; if no row exists for an (org, vertical) pair the
// fetcher falls back to the hardcoded defaults baked into the file.
// One row per (org, vertical) so the Settings UI can edit titles +
// per-firm cap without code changes.
model BdContactTargeting {
  id                      String   @id @default(cuid())
  organizationId          String
  verticalId              String   @unique
  primaryTitles           String[] @default([])
  smallFirmFallbackTitles String[] @default([])
  practiceSpecificTitles  String[] @default([])
  maxPerFirm              Int      @default(4)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical     @relation(fields: [verticalId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Recruiter-managed mapping of an Apollo sequence (built in Apollo) to a
// vertical, so sequences are self-serve in BD Settings instead of hardcoded
// in apollo-sequences.ts. The saved-search "Mapped Apollo Sequence" dropdown
// + the Apollo Integration table read from here; apollo-sequences.ts stays as
// the fallback when this table is empty. verticalId is nullable + SetNull so
// deleting a vertical unlinks the mapping rather than destroying it. The enroll
// path is unchanged — it still resolves its default from apollo-sequences.ts.
model BdSequence {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  apolloSequenceId String
  verticalId       String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical?    @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  // One mapping per Apollo sequence per org, so an upsert seed is idempotent
  // and the same sequence can't be added twice.
  @@unique([organizationId, apolloSequenceId])
  @@index([organizationId])
}

// Per-(org, threadId) record that the BD-reply "Create client?" prompt
// has been dealt with — either by creating a client (action="CREATED")
// or by the recruiter explicitly skipping (action="SKIPPED"). The mail
// thread view hides the banner whenever a row exists, satisfying the
// "only shows once per thread" rule.
model BdReplyPromptDismissal {
  id             String   @id @default(cuid())
  organizationId String
  threadId       String
  action         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, threadId])
  @@index([organizationId])
}

// Indeed-detected public job posting at an existing Client. Surfaced
// on the Client Signal tab so the recruiter can act before a competitor
// does. NEW → ACTED (reach-out sent) or DISMISSED. externalUrl is
// unique per org so re-scanning the same posting upserts cleanly.
// One row per public job posting at a company that fuzzy-matched an
// existing Client. Written by the BD discovery cron when a TheirStack
// hit would otherwise be excluded for being an existing client —
// instead of dropping it we route it here so the recruiter sees
// "these clients are hiring publicly, reach out before someone else
// does". `clientId` is set when the fuzzy match resolved to a Client
// row; left null when we want to keep the signal but the match was
// soft.
model ClientSignal {
  id             String             @id @default(cuid())
  organizationId String
  companyName    String
  clientId       String?
  verticalId     String?
  jobTitle       String
  jobLocation    String?
  jobPostingUrl  String?
  postedAt       DateTime?
  discoveredAt   DateTime           @default(now())
  status         ClientSignalStatus @default(NEW)
  actedAt        DateTime?
  dismissedAt    DateTime?
  raw            Json?
  // Surface origin: "BD_DISCOVERY" (BD run flagged a client match) vs
  // "CLIENT_MONITOR" (nightly direct scan of existing clients). Set
  // once on create; subsequent upserts from either path leave it.
  source         String             @default("BD_DISCOVERY")
  // Last time a sync confirmed this posting still appears in
  // TheirStack. CLIENT_MONITOR refreshes this every cron tick.
  lastSeenAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vertical     Vertical?    @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  @@unique([organizationId, companyName, jobTitle])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([organizationId, discoveredAt])
}

// Ace-native reminders. Toast/panel only — never pushed to Google
// Calendar. Created from the /calendar reminders panel; dismissed
// once the recruiter acknowledges. No User FK because Ace is a tiny
// fixed team and we want to avoid cascade-delete games; userId is
// stored as a free string for attribution only.
model AceReminder {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String
  title            String
  // The reminder's anchor time. For standalone panel reminders this is
  // when the reminder is "about" and what shows on the calendar;
  // notifications fire at reminderAt minus each lead in notifyLeadsMin.
  // Event/interview-linked rows store the exact fire time here and use
  // notifyLeadsMin [0] so they keep firing at that instant.
  reminderAt       DateTime
  // Minutes-before-anchor at which to notify. Default is a single
  // 15-minute lead; the panel editor lets a recruiter stack a second
  // or third lead (e.g. [15, 60, 1440]).
  notifyLeadsMin   Int[]    @default([15])
  // Leads from notifyLeadsMin that have already fired, so each lead
  // pops once and survives a reload. Reset when time or leads change.
  notifiedLeadsMin Int[]    @default([])
  dismissed        Boolean  @default(false)
  // Optional link to the CalendarEvent that minted this reminder via
  // the drawer's "Ace reminder" toggle. Lets us upsert / delete the
  // reminder when the event is re-saved, and lets page.tsx show the
  // toggle in the right state when the drawer reopens. Standalone
  // panel-created reminders leave this null.
  calendarEventId  String?
  // Optional link to the Interview row that minted this reminder via
  // the scheduling flow. Lets reschedule upsert the existing reminder
  // by interviewId instead of creating a duplicate.
  interviewId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([calendarEventId])
  @@index([interviewId])
}

// Web push subscription stamped per browser/device that opts in. The
// `endpoint` from the Push API uniquely identifies a (browser, profile,
// VAPID public key) tuple — using it as the unique key dedupes when the
// same device re-subscribes. Sender path: sendPushToUser /
// sendPushToOrg in src/lib/web-push.ts. On 410/404 from the push
// service the row is deleted (subscription expired / user revoked).
model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

// Standalone recruiter notes. Distinct from the legacy Candidate.notes /
// Client.notes text columns and the Candidate.raw.notes array — those
// stay in place for the existing profile Notes tabs. This model backs
// the /notes page (composer + saved list) and the per-entity activity
// feed entries. A note can be loose (no attachments) OR attached to
// any combination of Candidates, Clients, and Jobs at the same time —
// recruiter often wants the same note showing on both the candidate
// profile and the job profile. The three relations are implicit
// many-to-many; Prisma manages the join tables.
model Note {
  id                String  @id @default(cuid())
  organizationId    String
  createdById       String
  title             String?
  body              String  @db.Text
  pinned            Boolean @default(false)
  // Drag-and-drop ordering within the user's note list. Lower wins;
  // new notes default to 0 (top of list) and the recruiter can drag
  // to assign explicit positions. Tied positions break by updatedAt
  // desc so brand-new notes still float above the reordered set.
  position          Int     @default(0)
  // When set, this note was auto-fanned out from an offer/placement save
  // (local-placement-actions.ts). It is the idempotency key: the fanout
  // upserts ONE note per placement deal keyed by (sourcePlacementId,
  // createdById, organizationId), so re-saving an offer or advancing it to
  // placement updates the same row instead of creating a duplicate on the
  // candidate/client/job profiles. Plain scalar tag (no FK relation) so the
  // column stays additive and a placement delete never cascades the note.
  sourcePlacementId String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  candidates   Candidate[]  @relation("NoteCandidates")
  clients      Client[]     @relation("NoteClients")
  jobs         Job[]        @relation("NoteJobs")

  @@index([organizationId, createdById, updatedAt])
  @@index([sourcePlacementId])
}

// Status lifecycle for a "Send Later" scheduled email.
//   SCHEDULED — waiting for the per-minute cron to fire it.
//   SENDING   — claimed by a cron tick (guards against double-send if
//               two ticks overlap on a slow send).
//   SENT      — delivered via Gmail; sentMessageId/sentThreadId set.
//   FAILED    — Gmail rejected the send; lastError holds the reason and
//               the app-shell poller surfaces a Retry toast.
//   CANCELED  — recruiter pulled it back before it fired.
enum ScheduledEmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

// A "Send Later" email. Holds the full send payload so the per-minute
// cron (/api/cron/scheduled-send) can fire it through the same sendGmail
// path the live composers use. Org-scoped (tenant boundary) AND
// user-scoped (the userId's Gmail account is what actually sends, mirroring
// /api/mail/send where the user's refresh token is the boundary).
//
// Single-send surfaces (FAB, thread reply, candidate email) also stash a
// Gmail draft (gmailDraftId) so the scheduled email sits in the Drafts
// folder until it fires; the cron deletes that draft on a successful send.
// Bulk scheduling skips draft creation to avoid piling dozens of drafts
// into the Drafts label.
model ScheduledEmail {
  id                  String               @id @default(cuid())
  organizationId      String
  userId              String
  to                  String[]             @default([])
  cc                  String[]             @default([])
  bcc                 String[]             @default([])
  subject             String
  bodyHtml            String               @db.Text
  bodyText            String               @db.Text
  // Threaded reply target. Null for fresh sends.
  threadId            String?
  // Selected "Send mail as" alias from the composer's From dropdown.
  sendAsEmail         String?
  // [{ filename, mimeType, dataBase64 }] — same shape the send/draft
  // routes accept. Null when there are no attachments.
  attachments         Json?
  // The Gmail draft mirroring this scheduled email so it shows in the
  // Drafts folder. Deleted on successful send. Null for bulk sends.
  gmailDraftId        String?
  scheduledSendAt     DateTime
  // IANA zone the recruiter picked (default ET). Display-only; the
  // scheduledSendAt instant is already absolute (stored UTC).
  timezone            String               @default("America/New_York")
  status              ScheduledEmailStatus @default(SCHEDULED)
  attempts            Int                  @default(0)
  lastError           String?
  sentMessageId       String?
  sentThreadId        String?
  // When true the cron auto-tags the resulting thread to any
  // candidate/client whose address appears in To/CC (parity with
  // /api/mail/send). Bulk rows leave this off.
  autoTag             Boolean              @default(true)
  // Optional activity-log lineage so the cron can record an
  // "email_sent" ActivityLog on fire (e.g. bulk candidate emails).
  candidateId         String?
  source              String?
  // Set true once the failure toast has been shown + dismissed so the
  // app-shell poller doesn't re-surface the same failure every tick.
  failureAcknowledged Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status, scheduledSendAt])
  @@index([userId, status])
}

// Inbound Instantly replies, mirrored into Neon by the poller cron
// (/api/cron/instantly-replies).
//
// Ace NEVER writes to Instantly. Read/unread state (`readAt`) and the
// notification guard (`notifiedAt`) live here and here only - marking a
// reply read in Ace has no effect on the Instantly Unibox.
//
// `isAutoReply` is THREE-STATE and drives whether a reply may notify:
//   false -> confirmed genuine. Notifies, counts toward the badge.
//   true  -> confirmed auto-reply (out-of-office etc). Stored for the
//            record, NEVER notifies, NEVER counts toward the badge.
//   null  -> not yet resolved. Instantly's list endpoint omits the flag,
//            so it takes a per-row /emails/{id} call to settle. Does not
//            notify while attempts remain; once enrichAttempts hits the
//            cap it notifies anyway, flagged unverified - missing a real
//            client reply costs more than dismissing a stray OOO.
model InstantlyReply {
  id               String    @id @default(cuid())
  organizationId   String
  // Instantly's own email id. Unique so a re-poll of an overlapping
  // window upserts instead of double-counting.
  instantlyEmailId String    @unique
  threadId         String?
  campaignId       String?
  campaignName     String?
  leadEmail        String?
  fromEmail        String?
  subject          String    @default("")
  snippet          String    @default("")
  bodyText         String    @default("") @db.Text
  receivedAt       DateTime
  // The warmed sending identity this reply came back through. Also the
  // source we derive the "our own accounts" set from - GET /accounts
  // needs a scope the key doesn't carry, but every row names its own
  // eaccount, so the sending identities can be learned from the data.
  eaccount         String?
  isFocused        Boolean   @default(true)
  isAutoReply      Boolean?
  enrichAttempts   Int       @default(0)
  // True when the sender is one of OUR OWN identities - a warmed sending
  // account, or a team address. Instantly ingests the whole thread from
  // the synced mailbox, so a reply sent from andrew@breakpointtalent.com
  // comes back under email_type=received. Those are our outbound mail,
  // never a lead reply: excluded from the list, the badge, and the count.
  isOwnSender      Boolean   @default(false)
  // Set when the auto-reply check gave up. The reply still notifies, but
  // the toast and the row both say the check never completed.
  enrichGaveUp     Boolean   @default(false)
  readAt           DateTime?
  // Best-effort mirror of readAt into Instantly's Unibox. Local readAt is
  // authoritative and is NEVER reverted on a sync failure - a badge that
  // lies about what you've already seen is worse than a thread staying
  // unread in Instantly. Retried by the poller, capped.
  instantlyReadSyncedAt   DateTime?
  instantlyReadSyncAttempts Int     @default(0)
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, receivedAt])
  @@index([organizationId, isAutoReply, readAt])
  @@index([organizationId, isOwnSender, receivedAt])
  @@index([organizationId, isAutoReply, enrichAttempts])
}

// ---- Goals ----
// A target the desk is held to. Two scopes: COMPANY (the whole org) and
// USER (one person's number). Every row is org-scoped per architecture
// rule 8.
//
// Actuals come from ONE of two places, never both:
//   - metric != MANUAL: computed live from the canonical Ace tables
//     (Invoice.paidAt for REVENUE, Client.feeAgreementSignedAt for
//     SIGNED_CLIENTS, Placement.stage/stageMovedAt for the pipeline
//     metrics, etc.). No stored actual, so a corrected invoice or a
//     re-staged placement moves the number with no backfill.
//   - metric == MANUAL: summed from GoalActualEntry rows. This is the
//     escape hatch for numbers Ace has no feed for yet (Instantly
//     campaign counts, LinkedIn posting success rate, Indeed messages).
//     When one of those grows a real feed it becomes a new GoalMetric
//     value and its goals switch over; the entries stay as history.

enum GoalScope {
  COMPANY
  USER
}

enum GoalMetric {
  REVENUE
  SIGNED_CLIENTS
  PLACEMENTS
  SUBMITTALS
  INTERVIEWS
  BD_CONTACTS_ENROLLED
  BD_REPLIES
  // No automatic feed. Actual = sum of this goal's GoalActualEntry rows,
  // and manualLabel names what is being counted.
  MANUAL
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  // Cumulative all-time. periodStart / periodEnd are null for these and
  // for these only - a milestone has no window to fall outside of.
  MILESTONE
}

enum GoalStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ACHIEVED
  MISSED
  ARCHIVED
}

model Goal {
  id               String     @id @default(cuid())
  organizationId   String
  scope            GoalScope
  // The person this goal belongs to. Null when scope is COMPANY, set when
  // scope is USER. App-layer invariant, not a DB constraint - Postgres
  // can't express "null exactly when scope = COMPANY" across two columns.
  ownerUserId      String?
  metric           GoalMetric
  // Required in app logic when metric is MANUAL, ignored otherwise. Names
  // what the manual entries are counting, e.g. "LinkedIn posts landed".
  manualLabel      String?
  period           GoalPeriod
  // Nullable ONLY because MILESTONE goals are cumulative and have no
  // window. Every other period sets both.
  periodStart      DateTime?
  periodEnd        DateTime?
  // One money/count column rather than two. Decimal(14, 2) covers dollar
  // targets with headroom and holds whole-number counts (9 signed clients)
  // exactly, so the metric decides how it renders, not the storage type.
  targetValue      Decimal    @db.Decimal(14, 2)
  // Rolls this goal up into a longer one - the four 2026 quarterly revenue
  // goals point at the 2026 annual. NoAction on delete so a parent can't
  // be removed while children still reference it; re-parent or archive
  // instead of orphaning the rollup.
  parentGoalId     String?
  status           GoalStatus @default(DRAFT)
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?
  declinedReason   String?    @db.Text
  // ANNUAL goals only. The percent to raise this year's target by when
  // seeding next year's goal. Null everywhere else.
  escalationPct    Int?
  notes            String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentGoal    Goal?             @relation("GoalRollup", fields: [parentGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childGoals    Goal[]            @relation("GoalRollup")
  actualEntries GoalActualEntry[]

  // ownerUserId / createdByUserId / approvedByUserId are scalar FKs with no
  // Prisma relation field, the same choice RetainedSearch makes and for the
  // same reason: three more named back-relations on the NextAuth User model
  // buys nothing the goals code needs (it resolves names with one findMany
  // over the org's members) and keeps this addition off the auth model.

  @@index([organizationId])
  @@index([organizationId, scope, status])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, metric, periodStart, periodEnd])
  @@index([parentGoalId])
}

// A hand-entered actual for a MANUAL goal. One row per contribution, not
// a running total, so entries can be corrected or removed individually and
// the goal's actual is always SUM(value) over its rows.
//
// Automatic metrics ignore this table entirely - if rows ever exist under a
// non-MANUAL goal (a metric switched after entries were logged) they are not
// read, and are kept only as history.
model GoalActualEntry {
  id              String   @id @default(cuid())
  organizationId  String
  goalId          String
  value           Decimal  @db.Decimal(14, 2)
  // The date the value counts toward, which is NOT createdAt - Monday's
  // calls logged on Tuesday still belong to Monday and to whichever goal
  // period contains it.
  entryDate       DateTime
  enteredByUserId String
  note            String?  @db.Text
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([goalId])
  @@index([goalId, entryDate])
  @@index([organizationId, entryDate])
}
