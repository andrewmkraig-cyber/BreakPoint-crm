// ACE (BreakPoint Talent CRM) - Prisma schema
// RecruiterFlow holds candidate/job/client data. Postgres holds local state only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth (NextAuth PrismaAdapter tables) ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  actions         ActionLog[]
  krispcalls      KrispcallLog[]
  agreements      ClientAgreement[]
  benefitsUpdates ClientBenefits[]
}

enum UserRole {
  ADMIN
  MEMBER
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- App state ----

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String   @db.Text
  trigger     String?  // e.g. "candidate_submitted", "interview_scheduled"
  audience    String?  // "client" | "candidate"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trigger])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Local cache for KPI rollups; regenerated periodically.
model KpiCache {
  id         String   @id @default(cuid())
  scope      String   // "user:<id>" | "team"
  period     String   // "week:2026-W15" | "quarter:2026-Q2"
  metrics    Json
  refreshedAt DateTime @default(now())

  @@unique([scope, period])
}

model ActionLog {
  id          String   @id @default(cuid())
  userId      String
  actionType  String   // "email_sent" | "call_made" | "note_added" | "status_change" | "stage_change" | "submit" | "reject" | "keep" | "schedule_interview"
  subjectType String   // "candidate" | "job" | "client" | "contact"
  subjectId   String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subjectType, subjectId])
  @@index([actionType])
}

// Manually uploaded client-facing agreements (PDFs etc). We store the binary
// in Postgres for now — volume is low, and keeping it in the same DB avoids a
// separate object-store dependency. Can swap to Vercel Blob later if volume grows.
model ClientAgreement {
  id           String   @id @default(cuid())
  clientRfId   Int      // RecruiterFlow client/company id
  filename     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  uploadedAt   DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([clientRfId, uploadedAt])
}

// Free-form benefits notes per client. Persisted as plain text with line breaks
// preserved; we can upgrade to markdown/rich text later without a schema change.
model ClientBenefits {
  id          String   @id @default(cuid())
  clientRfId  Int      @unique
  body        String   @db.Text
  updatedById String
  updatedAt   DateTime @updatedAt

  updatedBy User @relation(fields: [updatedById], references: [id], onDelete: Cascade)
}

model KrispcallLog {
  id            String   @id @default(cuid())
  userId        String
  krispcallId   String   @unique
  direction     String   // "inbound" | "outbound"
  kind          String   // "call" | "sms"
  candidateRfId String?  // RecruiterFlow candidate id if matched
  phoneNumber   String
  durationSec   Int?
  recordingUrl  String?
  transcript    String?  @db.Text
  body          String?  @db.Text
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([candidateRfId])
}
