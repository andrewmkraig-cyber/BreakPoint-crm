// ACE (BreakPoint Talent CRM) - Prisma schema
// RecruiterFlow holds candidate/job/client data. Postgres holds local state only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth (NextAuth PrismaAdapter tables) ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  actions               ActionLog[]
  activities            ActivityLog[]
  agreements            ClientAgreement[]
  benefitsUpdates       ClientBenefits[]
  benefitsFiles         ClientBenefitsFile[]
  resumeUploads         ResumeUpload[]
  candidateResumes      CandidateResume[]
  placements            Placement[]
  jobOverrides          JobOverride[]
  candidates            Candidate[]
  interviews            Interview[]
  ownedOrganizations    Organization[]           @relation("OrganizationOwner")
  memberships           OrganizationMembership[]
  profile               UserProfile?
  // Phase 5A.4: lists the user has created. Inverse of
  // CandidateList.createdBy.
  createdCandidateLists CandidateList[]          @relation("CandidateListCreatedBy")
  chessPuzzleStreak     ChessPuzzleStreak?
  funFactFeedback       FunFactFeedback[]
}

// Per-user branding for the email signature, resume header, and any
// surface that wants a recruiter-specific identity block. One row per
// User, cascade-deletes with the User. Logo bytes live inline so the
// signature HTML can embed them as a data: URI (email clients won't
// load remote images without user action).
model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String?
  jobTitle     String?
  phone        String?
  website      String?
  logoData     Bytes?
  logoMimeType String?
  // Personal info (Settings → Personal Info). Birthday drives the
  // dashboard horoscope chip's zodiac sign automatically when present.
  // tshirtSize is a free-form string; UI restricts to XS..3XL.
  birthday     DateTime? @db.Date
  address      String?
  tshirtSize   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  MEMBER
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- App state ----

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String   @db.Text
  trigger   String? // e.g. "candidate_submitted", "interview_scheduled"
  audience  String? // "client" | "candidate"
  // Coarse-grained category used by composer filters. Interview composers
  // surface every template with category="interview", regardless of trigger,
  // so recruiters can pick any interview-flavored template (client
  // confirmation, candidate prep, legacy confirmation, or any future
  // variants) from one dropdown.
  category  String? // "interview" | "submittal" | "offer" | "rejection" | "reference"
  isActive  Boolean  @default(true)
  // When true, the composer/send path should route this template's output
  // to the user's Gmail Drafts folder instead of sending immediately, so
  // the recruiter can approve before it goes out. Wired on the data layer
  // here; UI toggle ships with this column. Composer behavior is wired
  // in a follow-up.
  sendAsDraft Boolean @default(false)
  // Manual display order. Lower = earlier in the list. Settings ▸
  // Templates uses up/down chevrons to swap adjacent rows; the mail
  // composer's Use Template dropdown reads templates in this order so
  // recruiter favorites sit at the top. Seeded rows are spaced 10
  // apart so new templates can slot in between without renumbering.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trigger])
  @@index([category])
  @@index([sortOrder])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Local cache for KPI rollups; regenerated periodically.
model KpiCache {
  id          String   @id @default(cuid())
  scope       String // "user:<id>" | "team"
  period      String // "week:2026-W15" | "quarter:2026-Q2"
  metrics     Json
  refreshedAt DateTime @default(now())

  @@unique([scope, period])
}

model ActionLog {
  id             String   @id @default(cuid())
  userId         String
  actionType     String // "email_sent" | "call_made" | "note_added" | "status_change" | "stage_change" | "submit" | "reject" | "keep" | "schedule_interview"
  subjectType    String // "candidate" | "job" | "client" | "contact"
  subjectId      String
  metadata       Json?
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subjectType, subjectId])
  @@index([actionType])
  @@index([organizationId])
}

// Manually uploaded client-facing agreements (PDFs etc). We store the binary
// in Postgres for now — volume is low, and keeping it in the same DB avoids a
// separate object-store dependency. Can swap to Vercel Blob later if volume grows.
model ClientAgreement {
  id               String    @id @default(cuid())
  clientRfId       Int // RecruiterFlow client/company id (Phase 5: drop)
  clientId         String? // cuid FK to Client — backfilled in Phase 0
  filename         String
  mimeType         String
  size             Int
  data             Bytes
  uploadComplete   Boolean   @default(true)
  uploadedById     String
  uploadedAt       DateTime  @default(now())
  // Claude-generated summary of the contract terms. Persisted so we don't
  // re-summarize every view; cleared when the user re-generates or deletes.
  summary          String?   @db.Text
  summaryUpdatedAt DateTime?
  organizationId   String

  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clientRfId, uploadedAt])
  @@index([clientId, uploadedAt])
  @@index([organizationId])
}

// Free-form benefits notes per client. Persisted as plain text with line breaks
// preserved; we can upgrade to markdown/rich text later without a schema change.
model ClientBenefits {
  id             String   @id @default(cuid())
  clientRfId     Int      @unique
  clientId       String?  @unique
  body           String   @db.Text
  updatedById    String
  updatedAt      DateTime @updatedAt
  organizationId String

  updatedBy    User         @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// PDFs and docs attached to the benefits tab. Large files (>4.5MB) bypass the
// Vercel serverless function body limit via @vercel/blob client uploads, so
// blobUrl is the canonical storage. `data` is retained (nullable) for any
// legacy rows uploaded before the Blob cutover and is not written for new rows.
model ClientBenefitsFile {
  id             String   @id @default(cuid())
  clientRfId     Int
  clientId       String?
  filename       String
  mimeType       String
  size           Int
  blobUrl        String? // legacy Vercel Blob URL; nullable for new chunked rows
  blobPathname   String?
  data           Bytes? // primary storage for chunk-assembled files
  uploadComplete Boolean  @default(true)
  uploadedById   String
  uploadedAt     DateTime @default(now())

  organizationId String

  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clientRfId, uploadedAt])
  @@index([clientId, uploadedAt])
  @@index([organizationId])
}

// One row per candidate-job placement lifecycle. Ace owns the stage locally
// because RF has no stage-change API exposed on /external. `stage` transitions
// offer → pending_start → hired; the previous stages' columns stick around so
// the full placement history is on one row.
model Placement {
  id            String  @id @default(cuid())
  // Exactly one of candidateRfId / candidateId is set. App-layer invariant,
  // not enforced at the DB level — Postgres can't express XOR constraints
  // across nullable columns. RF candidates keep using candidateRfId; Ace-
  // local candidates use candidateId (cuid) and leave candidateRfId null.
  candidateRfId Int?
  candidateId   String?
  jobRfId       Int? // Phase 2: nullable — Ace-native Jobs leave this null
  jobId         String? // cuid FK to Job — backfilled in Phase 0
  clientRfId    Int? // Phase 2: nullable — Ace-native Clients leave this null
  clientId      String? // cuid FK to Client — backfilled in Phase 0
  stage         String // "offer" | "pending_start" | "hired"

  // Offer details
  offerReceivedAt DateTime?
  offerSalary     Int? // annual base in whole currency units
  offerCurrency   String?   @default("USD")
  offerTitle      String?
  offerStartDate  DateTime?
  offerNotes      String?   @db.Text

  // Placement (offer accepted, fee locked) details
  placedAt            DateTime?
  acceptedSalary      Int?
  acceptedCurrency    String?   @default("USD")
  feePercentage       Float?
  feeTotal            Int?
  minFee              Int?
  guaranteePeriodDays Int?
  billingContactName  String?
  billingContactEmail String?
  // Multiple billing contacts per placement, stored as a JSON array of
  // { name, email } objects. We mirror the first entry into the legacy
  // billingContactName / billingContactEmail columns above so the Pipeline
  // table and any other single-contact reader keeps working without a
  // wave of call-site updates.
  billingContacts     Json?
  hiringManagerName   String?
  hiringManagerEmail  String?
  expectedStartDate   DateTime?
  placementNotes      String?   @db.Text

  // Hired (start confirmed) details
  startConfirmedAt      DateTime?
  startConfirmationFile Bytes?
  startConfirmationMime String?
  invoicingFlagged      Boolean   @default(false)
  invoicedAt            DateTime?

  // Manual city override for the placements dashboard. Lets Andrew fix
  // rows where Client.location.city is missing or wrong without editing
  // the client record itself. Reads fall back to Client.location.city
  // when null.
  cityOverride          String?

  // True if the last stage change was successfully pushed to RF. Currently
  // always false because RF /external has no stage-change endpoint; the UI
  // shows an "(Ace only)" badge when this is false.
  syncedToRf Boolean @default(false)

  // How the candidate first landed on this job. Set on the row's first
  // write and not touched by later stage moves. Examples:
  //   "recruiter_applied"  — recruiter clicked Apply in Ace
  //   "job_board"          — inbound from a job-board feed
  //   "careers_form"       — inbound from the public apply link
  //   "rf_import"          — pre-existing RF stage_name carried in
  // null means the source wasn't recorded (older rows).
  source String?

  // Sourcing channel the candidate originally came from for this placement.
  // One of: "LinkedIn" | "Pin" | "Indeed" | "Network" | "Referral" |
  // "Apollo BD" | "Other". Powers the Financial Performance source mix.
  candidateSource String?

  createdById    String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  candidate      Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job            Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@unique([candidateRfId, jobRfId])
  @@unique([candidateId, jobRfId])
  @@unique([candidateId, jobId])
  @@index([clientRfId, stage])
  @@index([clientId, stage])
  @@index([jobId, stage])
  @@index([stage, expectedStartDate])
  @@index([candidateId, stage])
  @@index([organizationId])
}

// Ace-native candidate record. Created by /candidates/new — no RF
// involvement in the save path. `rfId` is intentionally nullable and is
// NOT populated at create time; it's reserved for a future manual-pull or
// admin-tool scenario, not for automatic sync.
model Candidate {
  id   String @id @default(cuid())
  rfId Int?   @unique

  firstName           String
  lastName            String?
  email               String?  @unique
  phone               String?
  currentDesignation  String?
  currentOrganization String?
  location            String?
  // Geocoded from `location` via the one-shot scripts/geocode-candidates.ts
  // backfill (Nominatim). The /api/candidates/search route uses these to
  // run a bounding-box radius filter when the user supplies a location +
  // distance, falling back to a text-contains match if either is null
  // (e.g. unparseable locations like "Remote").
  lat                 Float?
  lng                 Float?
  linkedinProfile     String?
  skills              String[] @default([])
  // Free-form tags + RF attributes normalized to strings (e.g. "kept",
  // "keep"). Used by the profile chips and the keep filter.
  tags                String[] @default([])
  // RF expected-salary blob { number, currency } kept as Json so we don't
  // have to split it into columns just to preserve the display shape.
  expectedSalary      Json?
  notes               String?  @db.Text
  experience          Json?
  education           Json?
  // RF-imported candidates get the original payload stashed here so profile
  // features that depend on RF-only fields (linked jobs[], source_name,
  // candidate_summary, etc.) keep working without an ongoing RF dependency.
  // Ace-native candidates leave it null.
  raw                 Json?

  // Resume copied from the ResumeUpload staging row on save. Kept in the
  // same row so the profile page can stream it back with a single query.
  resumeFilename   String?
  resumeMimeType   String?
  resumeSize       Int?
  resumeData       Bytes?
  resumeUploadedAt DateTime?

  createdById    String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy       User                      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  placements      Placement[]
  interviews      Interview[]
  invoices        Invoice[]
  // Phase 5A.5.a: now 1:N — multiple resume versions per candidate.
  resumes         CandidateResume[]
  // Phase 5A.4: candidate-list memberships. Cascade-delete on the
  // membership side so removing a candidate cleans up their list
  // memberships without affecting the lists themselves.
  listMemberships CandidateListMembership[]
  gmailTags       GmailThreadTag[]
  matches         CandidateMatch[]
  calendarEvents  CalendarEvent[]

  @@index([email])
  @@index([firstName])
  @@index([lastName])
  @@index([createdById, createdAt])
  @@index([organizationId])
}

// Persistent resume file attached to an existing RF candidate record. Unique
// on candidateRfId — replacing the resume upserts the single row. The chunked
// upload handler clears `data` on chunk 0 so re-upload doesn't concat to old
// bytes.
model CandidateResume {
  id             String   @id @default(cuid())
  // Phase 5A.5.a: dropped the @unique on candidateRfId / candidateId
  // so a candidate can carry multiple uploaded versions. Each upload
  // creates its own row; the most-recent-by-uploadedAt is the default
  // legacy lookup target. Phase 5A.5.b (Ace 20.0): made nullable —
  // Ace-native uploads now write null. The previous -Date.now()
  // synthetic placeholder overflows PostgreSQL Int4 (2.15B max) and
  // produced a 500 on every Ace-native upload.
  candidateRfId  Int?
  candidateId    String?
  filename       String
  // Recruiter-set display name overriding the raw upload filename.
  // Used everywhere the resume name shows (header, dropdown, download
  // Content-Disposition). Falls back to filename when null/empty so
  // the UI never displays a blank.
  displayName    String?
  // Phase 5A.5.b: marks branded versions so the Version dropdown can
  // surface them as "Branded (date)" entries. null / "original" both
  // mean a raw upload; "branded" means the row was produced by the
  // Brand mode of the Edit Resume modal — the `data` blob is the
  // source resume with the BreakPoint logo stamped at the saved
  // coordinates. Kept as a free-form string so future variant kinds
  // (e.g. "watermarked", "anonymized") slot in without a migration.
  variant        String?
  mimeType       String
  size           Int
  data           Bytes
  uploadComplete Boolean  @default(true)
  uploadedById   String
  uploadedAt     DateTime @default(now())

  // Redacted version saved by the in-app PDF redactor. Stored as a separate
  // blob so the original is never overwritten — recruiters always have the
  // unredacted copy if they need it.
  redactedData     Bytes?
  redactedMimeType String?
  redactedSize     Int?
  redactedAt       DateTime?
  organizationId   String

  // Cached plaintext extraction of `data` (PDF → text via pdf-parse).
  // Drives the keyword-search resume-snippet column without re-parsing
  // bytes on every query. Capped at 50,000 chars by the backfill /
  // upload paths so a single oversized resume can't bloat the row.
  // null means "not yet extracted" (or extraction failed and we skipped
  // the row); the backfill script idempotently picks those up.
  extractedText String?

  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Interview schedule. Polymorphic on candidate like Placement: exactly one of
// candidateRfId / candidateId is set. Not linked to Placement by FK — the
// (candidate, jobRfId) tuple is the join key, mirroring how Placement itself
// is scoped. We upsert Placement.stage = "interviewing" at create time so the
// pipeline reflects the move.
model Interview {
  id                     String   @id @default(cuid())
  candidateRfId          Int?
  candidateId            String?
  jobRfId                Int? // Phase 2: nullable — Ace-native Jobs leave this null
  jobId                  String? // cuid FK to Job — backfilled in Phase 0
  clientRfId             Int? // Phase 2: nullable — Ace-native Clients leave this null
  clientId               String? // cuid FK to Client — backfilled in Phase 0
  scheduledAt            DateTime
  durationMin            Int      @default(30)
  type                   String // "phone_screen" | "video" | "in_person"
  meetLink               String?
  clientAttendees        Json? // [{ id?: number, name: string, email: string }]
  candidatePhone         String?
  // Street address for in_person interviews. Passed straight to Google
  // Calendar's event.location field so the native invite renders the
  // address (+ a Map link) inline.
  location               String?
  notes                  String?  @db.Text
  status                 String   @default("scheduled") // scheduled | completed | cancelled | rescheduled
  source                 String   @default("ace_scheduled") // ace_scheduled | client_scheduled
  // Google Calendar event id on the creator's primary calendar. The event
  // is created with just the creator at schedule time; the client and
  // candidate are added as attendees later via their respective email
  // composers. The googleEventIdClient / googleEventIdCandidate columns
  // are set (to the same event id) once that step completes, acting as
  // explicit "invite delivered" flags we can audit.
  // googleEventIdMine: only set for source=client_scheduled. For ace_scheduled
  // interviews we don't create a "master" event — the client + candidate
  // invite events ARE the calendar presence.
  googleEventIdMine      String?
  googleEventIdClient    String?
  googleEventIdCandidate String?
  // Meet conference identity — captured when the first invite creates the
  // Meet, so the second invite can attach the same Meet link. Both attendee
  // events share one Meet URL; users from either event land in the same room.
  meetConferenceId       String?

  createdById    String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([candidateRfId, scheduledAt])
  @@index([candidateId, scheduledAt])
  @@index([jobRfId, scheduledAt])
  @@index([jobId, scheduledAt])
  @@index([clientId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([organizationId])
}

// Staging table for chunk-uploaded resume PDFs. Transient: parseCandidate
// reads bytes here, runs Claude/fallback, then the row is deleted.
model ResumeUpload {
  id             String   @id @default(cuid())
  filename       String
  mimeType       String
  size           Int
  data           Bytes
  uploadComplete Boolean  @default(false)
  uploaderId     String
  createdAt      DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId, createdAt])
}

// Local override for fields that RF either doesn't expose or that the
// recruiter wants to author in Ace without bouncing back to RF (e.g. an
// internal-friendly description for merge fields). Keyed by RF job id —
// the master Job record still lives in RF; this just layers on top.
// When present, Ace prefers the override over the RF value for display
// and merge-field resolution.
model JobOverride {
  jobRfId        Int      @id
  jobId          String?  @unique
  // Optional Ace-authored title that wins over whatever RF's title /
  // name / position_title fields give us. Lets recruiters fix
  // "(untitled job)" rows on the Applicants list when RF imports
  // come in with empty title columns.
  title          String?
  description    String?  @db.Text
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  updatedById    String?
  organizationId String

  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model SmsMessage {
  id             String   @id @default(cuid())
  // Nullable so webhooks can store messages from unknown numbers. The
  // Phone tab surfaces those as "unknown" threads keyed by phoneOther
  // and offers "Add to Ace" affordances to link them to a Candidate /
  // Client contact later.
  candidateId    String?
  // Phone Tab Phase 1: tenant scope + client linkage. Both nullable to
  // permit a backfill pass; existing rows get organizationId stamped
  // from Candidate.organizationId by scripts. clientId stays null
  // until contact-side phone matching is wired in Phase 2.
  organizationId String?
  clientId       String?
  direction      String
  body           String
  fromNumber     String
  toNumber       String
  status         String   @default("sent")
  krispcallId    String?
  // Phone Tab Phase 2: read tracking for the sidebar unread badge.
  // Outbound rows are written true since the recruiter sent them;
  // inbound rows flip to true when the recruiter opens that thread.
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([candidateId])
  @@index([organizationId, createdAt])
}

model CallLog {
  id             String          @id @default(cuid())
  // Nullable so webhooks can store calls from unknown numbers, same
  // rationale as SmsMessage above.
  candidateId    String?
  // Phone Tab Phase 1: see SmsMessage above for the same nullable
  // organizationId / clientId rationale.
  organizationId String?
  clientId       String?
  direction      String
  fromNumber     String
  toNumber       String
  duration       Int?
  status         String
  recordingUrl   String?
  krispcallId    String?
  createdAt      DateTime        @default(now())
  transcript     CallTranscript?

  @@index([organizationId])
  @@index([candidateId])
}

model CallTranscript {
  id         String   @id @default(cuid())
  callLogId  String   @unique
  callLog    CallLog  @relation(fields: [callLogId], references: [id])
  transcript String   @db.Text
  summary    String?  @db.Text
  createdAt  DateTime @default(now())
}

model AiWorkspaceMessage {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  role       String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---- Ace-native client/job/contact models (Phase 0 of RF removal) ----
// legacyRfId columns are scaffolding for the migration — dropped in Phase 5
// once all reads/writes have moved to cuid FKs.

model Client {
  id             String    @id @default(cuid())
  legacyRfId     Int?      @unique // Phase 5: drop
  name           String
  domain         String?
  industry       String?
  linkedinPage   String?
  careersPage    String?
  companySize    String?
  overview       String?   @db.Text
  // Free-form recruiter notes attached to the client. Distinct from
  // `overview` (which is the public-facing about/summary blurb) — this
  // field is the scratchpad for "talked to Linda Tuesday, fee terms TBD"
  // style entries that show up under the Notes tab on the client profile.
  notes          String?   @db.Text
  location       Json?
  phoneNumbers   Json?
  tags           String[]  @default([])
  status         Json?
  revenue        Json?
  leadOwner      Json?
  customFields   Json?
  addedAt        DateTime?
  lastContact    DateTime?
  lastEngagement DateTime?
  raw            Json?
  // How this client first entered the desk. One of: "Apollo BD" |
  // "LinkedIn BD" | "Network" | "Referral" | "Existing client" |
  // "Website" | "Other". Powers the Financial Performance lead-source mix.
  leadSource     String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  jobs          Job[]
  contacts      Contact[]
  agreements    ClientAgreement[]
  benefits      ClientBenefits?
  benefitsFiles ClientBenefitsFile[]
  placements    Placement[]
  interviews    Interview[]
  invoices      Invoice[]
  gmailTags     GmailThreadTag[]
  clientSignals ClientSignal[]
  calendarEvents CalendarEvent[]

  @@index([name])
  @@index([organizationId])
}

model Job {
  id               String    @id @default(cuid())
  legacyRfId       Int?      @unique // Phase 5: drop
  title            String
  clientId         String?
  locations        String[]  @default([])
  // Structured location parts, written by the /jobs/new form so search
  // can filter by city / state / zip independently. The legacy
  // `locations` array continues to carry the composed "City, ST Zip"
  // string for callers that render free-form location text.
  locationCity     String?
  locationState    String?
  locationZip      String?
  // Canonical "is this job currently active in the pipeline" signal.
  // Active + Private both stay isOpen=true so search_jobs / find-matches
  // / pipeline reads keep surfacing private jobs (the recruiter is
  // still working them — they're just hidden from the default Active
  // tab on /jobs). Inactive flips this to false.
  isOpen           Boolean   @default(true)
  // Lifecycle bucket for the /jobs tabs. Three states:
  //   "active"   — default, surfaces on the Active tab
  //   "private"  — hidden from Active but still searchable / matchable
  //                (lives on its own Private tab)
  //   "inactive" — closed out, lives on the Inactive tab
  // Nullable for legacy rows; readers fall back to isOpen ? "active"
  // : "inactive" when null. New writes always set this column so every
  // post-migration row has an explicit lifecycle.
  lifecycle        String?   @default("active")
  jobStatus        Json?
  jobType          Json?
  employmentType   String?
  department       String?
  salaryRangeStart Int?
  salaryRangeEnd   Int?
  salaryCurrency   String?
  salaryFrequency  String?
  expectedFee      Json?
  billRate         Json?
  payRate          Json?
  numberOfOpenings Int?
  currentOpening   Int?
  hiringTeam       Json?
  customFields     Json?
  applyLink        String?
  lastOpenedAt     DateTime?
  createdAtRf      DateTime?
  // Phase 2: Ace-native Jobs store their description here. RF-imported
  // jobs keep rendering via raw.description + JobOverride.description
  // (the override layer pre-dates this column). Reads prefer, in order:
  //   JobOverride.description > Job.description > raw.description
  description      String?   @db.Text
  // Source URL the recruiter pasted (job board listing, client careers
  // page, LinkedIn post, etc.). Save URL persists this; Parse Link will
  // eventually fetch + extract the JD into rawJobDescription.
  sourceJobUrl     String?
  // Raw paste from a job board / client email. Lives next to the
  // recruiter-facing description so we can later diff / re-parse without
  // losing the original copy.
  rawJobDescription String?  @db.Text
  // Set whenever the recruiter-facing description was produced by the
  // BreakPoint Generate flow. Powers the "Last generated" timestamp on
  // the JD preview card; null means description was hand-edited or
  // imported, not Claude-generated.
  descriptionGeneratedAt DateTime?
  // Recruiter-only context (compensation flexibility, client quirks,
  // dealbreakers, etc.). Never rendered to candidates and never fed back
  // into the JD Generate prompt — read-only sidekick to description.
  internalRecruiterNotes String? @db.Text
  // Saved filter state for the per-job Matches tab. One snapshot per
  // job — the Save Search button on /jobs/[id] Matches writes the
  // current sidebar filter shape here, and the tab restores it on next
  // mount so the recruiter can pick up where they left off. Shape
  // mirrors the client `Filters` type; the loader coerces each field
  // against current defaults so a stale save can't crash the tab.
  savedSearchFilters Json?
  raw              Json?
  organizationId   String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client       Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  override     JobOverride?
  placements   Placement[]
  interviews   Interview[]
  matches      CandidateMatch[]
  boardStatuses JobBoardStatus[]
  calendarEvents CalendarEvent[]

  @@index([clientId])
  @@index([isOpen])
  @@index([title])
  @@index([organizationId])
  @@index([locationCity])
  @@index([locationState])
  @@index([locationZip])
}

// Per-job posting status across job boards. Powers the Promote tab on
// /jobs/[id]. The 6 major boards (LinkedIn, Indeed, ZipRecruiter,
// Glassdoor, SimplyHired, Monster) are seeded with NOT_CONFIGURED rows
// when a Job is created so the Promote tab always has a baseline; any
// extra rows the recruiter adds are local / niche boards and live with
// category="local_niche". boardName is unique per job so the seed +
// any later upsert calls don't stack duplicates.
enum JobBoardStatusValue {
  NOT_CONFIGURED
  READY
  POSTED
  SKIPPED
}

model JobBoardStatus {
  id             String              @id @default(cuid())
  organizationId String
  jobId          String
  boardName      String
  status         JobBoardStatusValue @default(NOT_CONFIGURED)
  notes          String?             @db.Text
  externalUrl    String?
  // "major" for the 6 seeded boards; "local_niche" for recruiter-added
  // rows. Kept loose (string) so a future "regional" / "industry" tier
  // doesn't require a schema migration.
  category       String              @default("major")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, boardName])
  @@index([organizationId])
  @@index([jobId])
}

// Game Plan Phase 2: persistent log of every candidate Find Matches has
// scored against a job. Lets the /jobs/[id] Matched tab survive page
// reloads / panel closes — once a candidate has been scored for a job,
// the row stays until explicitly removed. Unique on (jobId,
// candidateId) so re-running Find Matches upserts the latest score
// instead of stacking duplicates.
model CandidateMatch {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String
  candidateId    String
  score          Int
  rationale      String   @db.Text
  // Per-axis breakdown Claude emitted alongside the score (titleMatch,
  // locationFit, experienceFit, compensationFit, overallSummary). Stored
  // so the score popover renders the same explanation everywhere the
  // score is visible — Find Matches panel today, /jobs/[id] Matched tab
  // and any future surface that references the row. Nullable for legacy
  // rows written before this column existed; the popover falls back to
  // rationale when the JSON blob is null.
  scoreBreakdown Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId, score])
  @@index([organizationId])
}

model Contact {
  id                 String    @id @default(cuid())
  legacyRfId         Int?      @unique // Phase 5: drop
  firstName          String?
  lastName           String?
  name               String?
  emails             String[]  @default([])
  phoneNumbers       Json?
  clientId           String?
  currentDesignation String?
  linkedinProfile    String?
  notes              String?   @db.Text
  leadOwner          Json?
  addedAt            DateTime?
  lastActivityAt     DateTime?
  raw                Json?
  organizationId     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([name])
  @@index([organizationId])
}

// ---- Multi-tenancy scaffolding (Phase 1) ----
// Additive only: every tenant table has a nullable organizationId column and
// relation, so existing code paths (which don't yet read the column) keep
// working unchanged. The seed script stamps every existing row with the
// default BreakPoint Talent org cuid. Later phases will narrow the columns
// to NOT NULL and wire getCurrentOrg() into every server action.

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  plan          String   @default("personal")
  ownerId       String
  mercuryApiKey String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User                     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  memberships OrganizationMembership[]

  candidates           Candidate[]
  jobs                 Job[]
  clients              Client[]
  contacts             Contact[]
  placements           Placement[]
  interviews           Interview[]
  invoices             Invoice[]
  clientAgreements     ClientAgreement[]
  clientBenefits       ClientBenefits[]
  clientBenefitsFiles  ClientBenefitsFile[]
  candidateResumes     CandidateResume[]
  jobOverrides         JobOverride[]
  actionLogs           ActionLog[]
  activityLogs         ActivityLog[]
  // Phase 5A.4: per-org candidate lists. Cascade-delete on the list
  // side so deleting an org tears down its lists too.
  candidateLists       CandidateList[]
  gmailTags            GmailThreadTag[]
  candidateMatches     CandidateMatch[]
  personalTrainerRules PersonalTrainerRule[]
  claudePanelMessages  ClaudePanelMessage[]
  jobBoardStatuses     JobBoardStatus[]
  wordsOfDay           WordOfDay[]
  quotesOfDay          QuoteOfDay[]
  dailyNewsFeeds       DailyNewsFeed[]
  chessPuzzlesOfDay    ChessPuzzleOfDay[]
  chessPuzzleStreaks   ChessPuzzleStreak[]
  funFacts             FunFact[]
  verticals            Vertical[]
  savedSearches        SavedSearch[]
  savedSearchVersions  SavedSearchVersion[]
  sendingDomains       SendingDomain[]
  bdRuns               BDRun[]
  campaigns            Campaign[]
  campaignEvents       CampaignEvent[]
  bdActivities         BDActivity[]
  clientSignals        ClientSignal[]
  bdOrgConfig          BdOrgConfig?
  calendarEvents       CalendarEvent[]
  aceReminders         AceReminder[]
  toolExpenses         ToolExpense[]
}

// Tracks the recurring + one-time tool/software costs the desk pays.
// Powers the Total Expenses YTD + Gross Margin tiles on the Financial
// Performance dashboard tab. `cost * paidCount` is the running total
// paid to date for the line item.
model ToolExpense {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  cost           Float
  frequency      String
  paidCount      Int          @default(1)
  startDate      DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  invoiceNumber   String
  placementId     String?
  placement       Placement?    @relation(fields: [placementId], references: [id])
  candidateId     String?
  candidate       Candidate?    @relation(fields: [candidateId], references: [id])
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id])
  roleTitle       String?
  startDate       DateTime?
  feeAmount       Decimal?      @db.Decimal(10, 2)
  // Snapshot columns copied from the placement at create time so the
  // invoice stays self-describing even if the source placement is
  // later edited or deleted. Test invoices (no linked placement) write
  // these directly. Reads in the PDF + detail UI now hit these columns
  // instead of joining through Placement.
  baseSalary      Decimal?      @db.Decimal(10, 2)
  feePercentage   Decimal?      @db.Decimal(5, 2)
  paymentTerms    String?       @default("Net 30")
  dueDate         DateTime?
  billingContacts Json          @default("[]")
  hiringContacts  Json          @default("[]")
  status          InvoiceStatus @default(DRAFT)
  pdfPath         String?
  sentAt          DateTime?
  paidAt          DateTime?
  // Selected before the recruiter flips an invoice to PAID. Surfaces on
  // both the invoice detail view and the linked Placement so the desk
  // can scan how clients are actually paying without opening each PDF.
  paymentMethod   InvoicePaymentMethod?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum InvoicePaymentMethod {
  CHECK
  ACH
  CREDIT
}

// Mirrors a Google Calendar event for read-only display inside Ace.
// The sync job upserts these rows on demand keyed by
// (organizationId, googleEventId, calendarId) — calendarId varies per
// shared calendar (Andrew's primary + Austin's + any team calendars)
// so the same Google eventId can appear once per calendar without
// colliding. Status, attendees, and location are mirrored verbatim;
// candidateId/jobId/clientId stay null until a future pass correlates
// events to internal records.
model CalendarEvent {
  id             String              @id @default(cuid())
  organizationId String
  googleEventId  String
  calendarId     String
  calendarName   String              @default("primary")
  calendarColor  String?
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  allDay         Boolean             @default(false)
  location       String?
  attendees      Json?
  status         CalendarEventStatus @default(CONFIRMED)
  // Conference link surfaced from Google: hangoutLink first, then the
  // first video entryPoint in conferenceData. Stored separately from
  // location so a Zoom URL in the location field never overwrites it
  // and vice versa. Null when the Google event has no video link.
  meetLink       String?
  // Google's own canonical URL for the event (htmlLink). Used by the
  // drawer's "Open in Google Calendar" bridge so the recruiter can
  // reschedule/edit in Google while Ace-native editing is still being
  // wired up.
  htmlLink       String?
  candidateId    String?
  jobId          String?
  clientId       String?
  // Recruiter-chosen event type override from the drawer pill picker.
  // Null means "let the page derive a type heuristically from title +
  // calendar name"; a non-null value overrides the heuristic and is
  // canonical. One of: "interview" | "client" | "reminder" | "other".
  typeOverride   String?
  syncedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  candidate    Candidate?   @relation(fields: [candidateId], references: [id])
  job          Job?         @relation(fields: [jobId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  @@unique([organizationId, googleEventId, calendarId])
  @@index([organizationId, startTime])
}

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model ClaudePanelMessage {
  id             String       @id @default(cuid())
  organizationId String
  role           String
  content        String       @db.Text
  // Groups messages into a single Claude Panel "conversation". Clear
  // Chat rotates the active conversationId on the client rather than
  // deleting Neon rows, so cleared sessions are preserved as their own
  // entry on the Settings → Claude History tab. Nullable for the rows
  // that predate this column; History bucketed those by createdAt date.
  conversationId String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, conversationId])
}

// Personal Trainer rules — Andrew-curated standing instructions injected
// into every Claude-system-prompt across Ace. Source of truth lives here
// (Neon); a copy is mirrored to docs/ace/PERSONAL_TRAINER.md on every
// add/update/delete via the GitHub API for visibility, but writes always
// hit Neon first. Org-scoped so a future tenant can have its own rule
// set without affecting BreakPoint Talent's.
model PersonalTrainerRule {
  id             String   @id @default(cuid())
  organizationId String
  text           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Phase 5A.4: per-org candidate lists. Recruiter-curated buckets of
// candidates ("Top Tax Candidates", "Q4 follow-ups", etc.) used to
// filter the /candidates page and pivot candidate views. The list
// itself is org-scoped; memberships inherit org scoping through the
// list.list.organizationId path. (organizationId, name) is unique so
// two orgs can have a list with the same name without collision.
model CandidateList {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                      @relation("CandidateListCreatedBy", fields: [createdById], references: [id])
  memberships  CandidateListMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Join row between CandidateList and Candidate. Cascade-deletes from
// either side: removing a list drops every membership row (but leaves
// the candidates intact); removing a candidate drops its list
// memberships (but leaves the lists intact). (listId, candidateId)
// is unique so the same candidate can't be added to the same list
// twice.
model CandidateListMembership {
  id          String   @id @default(cuid())
  listId      String
  candidateId String
  addedAt     DateTime @default(now())

  list      CandidateList @relation(fields: [listId], references: [id], onDelete: Cascade)
  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([listId, candidateId])
  @@index([listId])
  @@index([candidateId])
}

// Phase 4c: ActivityLog is the canonical, tenant-scoped audit feed for
// user-initiated events across Ace. Separate from ActionLog (which is
// an older, hand-curated log used by specific workflows) — ActivityLog
// is general-purpose: every important user action lands here with a
// standard shape so Dashboard rollups, per-entity activity panels, and
// future admin audit tooling all read from one table.
//
// Action types fired today (Phase 4c):
//   candidate_created, submittal_sent, placement_confirmed
// Future (Phase 4d or wire-as-touched):
//   candidate_applied_to_job, interview_scheduled,
//   interview_cancelled, offer_extended, email_sent
// Intentionally excluded:
//   call_logged — Quo (OpenPhone-rebranded) webhook writes to CallLog.
//   Deferred until the audit-feed surfaces call rows on the activity
//   panel — at that point wire logActivity into the same webhook code
//   path that writes CallLog.
//
// targetType / targetId are a polymorphic FK to whatever the action is
// about (candidate / job / client / placement / interview). No referential
// integrity at the DB level so retention can tombstone target rows
// without cascading here.
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  timestamp      DateTime @default(now())
  actionType     String
  targetType     String
  targetId       String
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite index powers the Dashboard + per-user activity feeds
  // without a sort-after-filter step. (orgId, timestamp DESC) is the
  // typical read pattern: newest-first inside one tenant.
  @@index([organizationId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actionType])
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model GmailThreadTag {
  id             String   @id @default(cuid())
  threadId       String
  candidateId    String?
  clientId       String?
  organizationId String
  createdAt      DateTime @default(now())

  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([threadId, candidateId])
  @@unique([threadId, clientId])
  @@index([candidateId])
  @@index([clientId])
  @@index([organizationId])
}

// One row per org per day. The /api/word-of-day route checks for an
// existing row keyed on (organizationId, generatedDate) before calling
// Claude — so subsequent loads on the same ET day reuse the cached
// payload instead of spinning the model. generatedDate is @db.Date so
// the unique constraint compares calendar days, not instants.
model WordOfDay {
  id              String   @id @default(cuid())
  organizationId  String
  word            String
  partOfSpeech    String
  definition      String   @db.Text
  exampleSentence String   @db.Text
  generatedDate   DateTime @db.Date
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// Companion to WordOfDay — one row per (org, ET day) carrying a curated
// quote from a respected business leader, athlete, philosopher, or
// historical figure. /api/quote-of-day reuses the same cache-then-call
// pattern: today's row is returned without touching Claude on every
// load except the first of the ET day.
model QuoteOfDay {
  id             String   @id @default(cuid())
  organizationId String
  quote          String   @db.Text
  author         String
  context        String   @db.Text
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// One Lichess puzzle per (org, ET day). /api/chess-puzzle hits Lichess
// once on the first request of the day for an org and persists the
// result so every recruiter in the org sees the same board. Streak
// state stays in localStorage per browser — solving for the org would
// be weird (one person clicks a piece, the other gets credit).
// solution and themes are JSON to avoid a separate ordering column on
// the move list.
model ChessPuzzleOfDay {
  id             String   @id @default(cuid())
  organizationId String
  lichessId      String
  rating         Int
  fen            String   @db.Text
  solution       Json
  themes         Json
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// Per-user chess-puzzle streak. Lives on User (not Organization) so the
// daily count follows the recruiter across devices — solving today's
// puzzle on the iPad must credit the same row the laptop wrote. ET date
// strings (YYYY-MM-DD) match the client's todayET() formatter so a
// straight string compare drives the "solved today" / "failed today"
// guards. organizationId is denormalized for cleanup queries; it is not
// part of the unique key.
model ChessPuzzleStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  streak         Int      @default(0)
  lastSolvedDate String?
  failedDate     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// One Claude-generated fun fact per (org, ET day). The route rotates
// through topic categories (history, technology, science, geography,
// trivia) with weights biased by each user's recent thumbs feedback —
// so liked topics surface more often, disliked topics fade. Year is
// optional because non-history topics often don't have one.
model FunFact {
  id             String   @id @default(cuid())
  organizationId String
  topic          String
  year           Int?
  text           String   @db.Text
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feedback     FunFactFeedback[]

  @@unique([organizationId, generatedDate])
  @@index([organizationId])
}

// Per-user thumbs up/down feedback on a FunFact. The next day's
// generator reads this to bias topic selection toward the user's
// likes. One vote per (factId, userId); re-voting overwrites.
model FunFactFeedback {
  id        String   @id @default(cuid())
  factId    String
  userId    String
  vote      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fact FunFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([factId, userId])
  @@index([userId])
  @@index([factId])
}

// One row per (org, tab, ET day). The /api/news-feed route checks for
// today's row for the requested tab before invoking Claude — so once a
// recruiter clicks a tab, the headlines stay sticky for the rest of
// the ET day. headlines is a Json column carrying the {headline,
// source, url, summary}[] payload Claude returns; we don't normalize
// it because it's read-only inside the dashboard widget.
model DailyNewsFeed {
  id             String   @id @default(cuid())
  organizationId String
  tab            String
  headlines      Json
  generatedDate  DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tab, generatedDate])
  @@index([organizationId])
}

// ---- BD (Business Development) ----
// Outbound sequence orchestration. Ace = control center, Apollo =
// execution, Indeed = discovery. The morning cron picks up BDRuns with
// status=QUEUED and walks them through Indeed → Apollo. All BD models
// are tenant-scoped via organizationId per architecture rule 8.

enum BDRunStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  ENROLLING
  COMPLETE
  FAILED
  DISMISSED
}

enum SendingDomainStatus {
  HEALTHY
  WARMING
  COOLED
}

enum BDActivityKind {
  SCAN_COMPLETE
  ENRICH
  ENROLL
  OPEN
  REPLY
  BOUNCE
  UNSUB
  DOMAIN_COOLED
  DOMAIN_RESUMED
}

enum ClientSignalStatus {
  NEW
  ACTED
  DISMISSED
}

// Highest-level BD grouping. Drives the segmented control on Today's
// Launch and scopes saved searches + campaigns. Slug is the URL-safe
// identifier (e.g. "tax", "audit", "fpa"); name is the display label.
model Vertical {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  active         Boolean  @default(true)
  // Optional per-vertical override on the BD daily contact cap. Null
  // means inherit from BdOrgConfig.globalDailyCap.
  dailyCap       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedSearches SavedSearch[]
  bdRuns        BDRun[]
  campaigns     Campaign[]
  clientSignals ClientSignal[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// A recruiter-defined BD search — the criteria the morning Indeed scan
// uses to discover target companies. `criteria` Json is opaque to Ace
// (Indeed query shape lives there). `contactCap` overrides the org-level
// daily contact cap when set; null inherits.
model SavedSearch {
  id             String   @id @default(cuid())
  organizationId String
  verticalId     String
  name           String
  criteria       Json
  active         Boolean  @default(true)
  contactCap     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical             @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  versions     SavedSearchVersion[]
  bdRuns       BDRun[]
  campaigns    Campaign[]

  @@index([organizationId])
  @@index([verticalId])
}

// Append-only history of SavedSearch.criteria. One row per edit so
// later we can answer "what criteria did the 2026-03-04 run use?".
model SavedSearchVersion {
  id             String   @id @default(cuid())
  organizationId String
  savedSearchId  String
  criteria       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch  @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([savedSearchId, createdAt])
}

// One of the warmed sending domains Apollo rotates outbound across.
// Status WARMING / COOLED short-circuits the rotation; lastUsedAt
// drives round-robin selection at enroll time. apolloMailboxId pins
// the rotation slot to a specific Apollo sender.
model SendingDomain {
  id              String              @id @default(cuid())
  organizationId  String
  domain          String
  status          SendingDomainStatus @default(HEALTHY)
  apolloMailboxId String?
  dailyCap        Int?
  // Recruiter who owns the inbox tied to this warmed domain. Free-form
  // string so the UI can let either Andrew/Austin (or anyone added
  // later) own a slot without enum churn.
  inboxOwner      String?
  lastUsedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId])
}

// One row per Launch BD Run. Created on Launch click (status=QUEUED).
// The morning cron flips QUEUED → RUNNING, then COMPLETE / FAILED with
// metrics JSON capturing the actual scan/enrich/enroll counts so the
// Active Campaigns + Activity tabs can render the daily breakdown
// without re-hitting Indeed/Apollo on every load.
model BDRun {
  id                String      @id @default(cuid())
  organizationId    String
  // verticalId/savedSearchId are nullable so the org-wide BD discovery
  // cron can write a run that isn't tied to a single Launch saved-search.
  // Launch-initiated runs still pass both; only the cron leaves them null.
  verticalId        String?
  savedSearchId     String?
  status            BDRunStatus @default(QUEUED)
  discoveryProvider String      @default("theirstack")
  discoveredCount   Int         @default(0)
  // Post-filter discovered jobs array written by the BD discovery cron.
  // Approval flow reads this; once approved, the BDRun moves on to enroll.
  discoveredPayload Json?
  approvedAt        DateTime?
  enrolledCount     Int         @default(0)
  // Launch-time snapshot the cron reads when it picks the run up:
  // contact cap, sequence id, rotation pool, etc. Shape will drift
  // as we wire Apollo, so it stays as Json instead of a column wave.
  plan              Json?
  // Cron writes the final breakdown here on completion:
  // { companies, contacts, enrolled, errors }. Null until complete.
  metrics           Json?
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical?    @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  activities   BDActivity[]

  @@index([organizationId, createdAt])
  @@index([status])
  @@index([verticalId])
  @@index([savedSearchId])
}

// An active outbound campaign in Apollo, tracked from the Ace side.
// apolloSequenceId is the Apollo sequence id contacts get enrolled into
// — Ace never edits Apollo's copy, only records the linkage. Counters
// are denormalized for the Active Campaigns table; CampaignEvent has
// the granular per-contact log if a recompute is ever needed.
model Campaign {
  id               String   @id @default(cuid())
  organizationId   String
  verticalId       String
  savedSearchId    String
  bdRunId          String?
  apolloSequenceId String
  name             String
  enrolled         Int      @default(0)
  opens            Int      @default(0)
  replies          Int      @default(0)
  bounces          Int      @default(0)
  unsubs           Int      @default(0)
  active           Boolean  @default(true)
  startedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vertical     Vertical        @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch     @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  bdRun        BDRun?          @relation(fields: [bdRunId], references: [id], onDelete: SetNull)
  events       CampaignEvent[]

  @@index([organizationId])
  @@index([verticalId])
  @@index([active])
}

// Granular per-contact event log within a campaign. Apollo webhook
// writes one row per open/reply/bounce/unsub. Powers the Activity tab
// feed and lets us recompute Campaign counters if drift is suspected.
// apolloContactId is free-form because Apollo is the source of truth
// for outbound contacts — Ace doesn't ingest them into Contact.
model CampaignEvent {
  id              String         @id @default(cuid())
  organizationId  String
  campaignId      String
  kind            BDActivityKind
  apolloContactId String?
  metadata        Json?
  occurredAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([kind])
}

// BD-specific audit feed for the Activity tab. Mirrors ActivityLog's
// pattern but kept on a separate table so BD events don't dilute the
// general activity surface. Polymorphic target via targetType/targetId
// (e.g. "company", "campaign", "domain") with no DB-level FK so
// retention can tombstone targets without cascade.
model BDActivity {
  id             String         @id @default(cuid())
  organizationId String
  bdRunId        String?
  kind           BDActivityKind
  targetType     String?
  targetId       String?
  metadata       Json?
  occurredAt     DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bdRun        BDRun?       @relation(fields: [bdRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([bdRunId])
  @@index([kind])
}

// Org-level BD configuration: global daily contact cap, pause-all
// kill switch, blackout windows, and Reply Routing toggles. One row
// per organization, keyed on organizationId so reads are a single
// findUnique. UI in /settings/bd writes here; /bd/launch reads
// pauseAll + globalDailyCap on every render to gate the Launch CTA.
model BdOrgConfig {
  organizationId String @id

  // Master gate for the BD engine. The daily discovery cron and the
  // TheirStack webhook both no-op when false. Distinct from pauseAll,
  // which gates the Launch CTA only.
  engineActive   Boolean @default(false)
  globalDailyCap Int     @default(80)
  pauseAll       Boolean @default(false)

  blackoutWeekends   Boolean @default(false)
  blackoutHolidays   Boolean @default(false)
  blackoutBefore7am  Boolean @default(false)
  blackoutAfter530pm Boolean @default(false)

  replyForwardApollo       Boolean @default(false)
  replyAutoCreateCandidate Boolean @default(true)
  replyOooFilter           Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Indeed-detected public job posting at an existing Client. Surfaced
// on the Client Signal tab so the recruiter can act before a competitor
// does. NEW → ACTED (reach-out sent) or DISMISSED. externalUrl is
// unique per org so re-scanning the same posting upserts cleanly.
model ClientSignal {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  verticalId     String?
  externalUrl    String
  externalId     String?
  jobTitle       String?
  location       String?
  status         ClientSignalStatus @default(NEW)
  detectedAt     DateTime           @default(now())
  actedAt        DateTime?
  dismissedAt    DateTime?
  raw            Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vertical     Vertical?    @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalUrl])
  @@index([organizationId, status])
  @@index([clientId])
}

// Ace-native reminders. Toast/panel only — never pushed to Google
// Calendar. Created from the /calendar reminders panel; dismissed
// once the recruiter acknowledges. No User FK because Ace is a tiny
// fixed team and we want to avoid cascade-delete games; userId is
// stored as a free string for attribution only.
model AceReminder {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  title          String
  reminderAt     DateTime
  dismissed      Boolean      @default(false)
  // Optional link to the CalendarEvent that minted this reminder via
  // the drawer's "Ace reminder" toggle. Lets us upsert / delete the
  // reminder when the event is re-saved, and lets page.tsx show the
  // toggle in the right state when the drawer reopens. Standalone
  // panel-created reminders leave this null.
  calendarEventId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([calendarEventId])
}
